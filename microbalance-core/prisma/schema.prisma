generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase: runtime uses the transaction pooler (6543), while migrations and
  // `db push` need a session/direct connection (5432) for DDL.
  directUrl = env("DIRECT_URL")
}

// These enums are mapped to native Postgres enum types, so values are enforced
// by the database as well as the generated client. These are the canonical
// value sets for the engine.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalStatus {
  PENDING
  POSTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

enum BillStatus {
  DRAFT
  RECEIVED
  PAID
}

enum BankTxnStatus {
  UNRECONCILED
  RECONCILED
}

enum BankTxnType {
  INFLOW
  OUTFLOW
}

model Account {
  companyId String      @default("default")
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id        String      @id @default(cuid())
  code      String
  name      String
  type      AccountType
  category  String
  isSystem  Boolean     @default(false)
  balance   Decimal     @default(0) @db.Decimal(18, 2)

  journalLines JournalLine[]
  budgetLines  BudgetLine[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([type])
  @@index([category])
  @@index([companyId])
}

model JournalEntry {
  companyId String        @default("default")
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id        String        @id @default(cuid())
  date      DateTime
  memo      String?
  status    JournalStatus @default(PENDING)
  isLocked  Boolean       @default(false)
  lockedAt  DateTime?
  lines     JournalLine[]

  @@index([status])
  @@index([date])
  @@index([companyId])
}

model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal @default(0) @db.Decimal(18, 2)
  credit         Decimal @default(0) @db.Decimal(18, 2)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

model Customer {
  companyId String  @default("default")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id        String  @id @default(cuid())
  name      String
  email     String?
  phone     String?

  invoices SalesInvoice[]
  projects Project[]

  @@index([companyId])
}

model Vendor {
  companyId String  @default("default")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id        String  @id @default(cuid())
  name      String
  email     String?
  phone     String?

  bills PurchaseBill[]

  @@index([companyId])
}

model Item {
  companyId     String  @default("default")
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id            String  @id @default(cuid())
  name          String
  sku           String?
  price         Decimal @db.Decimal(18, 2)
  cost          Decimal @db.Decimal(18, 2)
  stockQuantity Int     @default(0)

  invoiceLines InvoiceLine[]

  @@index([companyId])
}

model SalesInvoice {
  companyId     String        @default("default")
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id            String        @id @default(cuid())
  customerId    String
  invoiceNumber String
  date          DateTime
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  totalAmount   Decimal       @db.Decimal(18, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(18, 2)

  customer         Customer          @relation(fields: [customerId], references: [id])
  lines            InvoiceLine[]
  bankTransactions BankTransaction[] @relation("MatchedInvoice")

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([companyId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  itemId      String?
  description String
  quantity    Decimal
  unitPrice   Decimal @db.Decimal(18, 2)
  total       Decimal @db.Decimal(18, 2)

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item?        @relation(fields: [itemId], references: [id])

  @@index([invoiceId])
  @@index([itemId])
}

model PurchaseBill {
  companyId   String     @default("default")
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id          String     @id @default(cuid())
  vendorId    String
  billNumber  String
  date        DateTime
  dueDate     DateTime
  status      BillStatus @default(DRAFT)
  totalAmount Decimal    @db.Decimal(18, 2)
  vatRate     Decimal    @default(7.5) @db.Decimal(5, 2)
  vatAmount   Decimal    @default(0) @db.Decimal(18, 2)
  amountPaid  Decimal    @default(0) @db.Decimal(18, 2)
  whtRate     Decimal    @default(0) @db.Decimal(5, 2)
  whtAmount   Decimal    @default(0) @db.Decimal(18, 2)
  netPayable  Decimal    @default(0) @db.Decimal(18, 2)

  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  lines            BillLine[]
  bankTransactions BankTransaction[] @relation("MatchedBill")

  @@index([vendorId])
  @@index([status])
  @@index([dueDate])
  @@index([companyId])
}

model BillLine {
  id          String  @id @default(cuid())
  billId      String
  description String
  quantity    Decimal
  unitCost    Decimal @db.Decimal(18, 2)
  total       Decimal @db.Decimal(18, 2)

  bill PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}

model BankTransaction {
  companyId        String        @default("default")
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id               String        @id @default(cuid())
  date             DateTime
  description      String
  amount           Decimal       @db.Decimal(18, 2)
  type             BankTxnType
  status           BankTxnStatus @default(UNRECONCILED)
  matchedInvoiceId String?
  matchedBillId    String?

  matchedInvoice SalesInvoice? @relation("MatchedInvoice", fields: [matchedInvoiceId], references: [id], onDelete: SetNull)
  matchedBill    PurchaseBill? @relation("MatchedBill", fields: [matchedBillId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([date])
  @@index([matchedInvoiceId])
  @@index([matchedBillId])
  @@index([companyId])
}

model Employee {
  companyId          String    @default("default")
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id                 String    @id @default(cuid())
  name               String
  email              String?
  basicSalary        Decimal   @default(0) @db.Decimal(18, 2)
  housingAllowance   Decimal   @default(0) @db.Decimal(18, 2)
  transportAllowance Decimal   @default(0) @db.Decimal(18, 2)
  isActive           Boolean   @default(true)
  expenses           Expense[]

  @@index([companyId])
}

model PayrollRun {
  companyId    String  @default("default")
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id           String  @id @default(cuid())
  month        String
  year         Int
  status       String  @default("DRAFT")
  totalGross   Decimal @default(0) @db.Decimal(18, 2)
  totalNet     Decimal @default(0) @db.Decimal(18, 2)
  totalPaye    Decimal @default(0) @db.Decimal(18, 2)
  totalPension Decimal @default(0) @db.Decimal(18, 2)
  totalNhf     Decimal @default(0) @db.Decimal(18, 2)

  @@unique([companyId, month, year])
  @@index([companyId])
}

model ExpenseCategory {
  companyId String    @default("default")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id        String    @id @default(cuid())
  name      String
  expenses  Expense[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Expense {
  companyId      String   @default("default")
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id             String   @id @default(cuid())
  date           DateTime
  description    String
  amount         Decimal  @db.Decimal(18, 2)
  categoryId     String
  employeeId     String?
  paymentMethod  String
  status         String   @default("PENDING")
  journalEntryId String?

  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  employee Employee?       @relation(fields: [employeeId], references: [id])

  @@index([status])
  @@index([categoryId])
  @@index([employeeId])
  @@index([companyId])
}

model FixedAsset {
  companyId               String    @default("default")
  company                 Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id                      String    @id @default(cuid())
  name                    String
  category                String
  purchaseDate            DateTime
  cost                    Decimal   @db.Decimal(18, 2)
  usefulLifeYears         Int
  salvageValue            Decimal   @default(0) @db.Decimal(18, 2)
  accumulatedDepreciation Decimal   @default(0) @db.Decimal(18, 2)
  isDisposed              Boolean   @default(false)
  disposalDate            DateTime?

  @@index([companyId])
}

model Budget {
  companyId  String       @default("default")
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id         String       @id @default(cuid())
  name       String
  fiscalYear Int
  startDate  DateTime
  endDate    DateTime
  status     String       @default("ACTIVE")
  lines      BudgetLine[]

  @@index([companyId])
}

model BudgetLine {
  id        String  @id @default(cuid())
  budgetId  String
  accountId String
  amount    Decimal @db.Decimal(18, 2)
  period    String  @default("ANNUAL")

  budget  Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@index([budgetId])
  @@index([accountId])
}

model BusinessProfile {
  companyId         String   @unique @default("default")
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  id                String   @id @default(cuid())
  name              String   @default("")
  address           String   @default("")
  phone             String   @default("")
  email             String   @default("")
  logoUrl           String?
  currency          String   @default("NGN")
  fiscalYearStart   String   @default("January")
  vatRate           Decimal  @default(7.5) @db.Decimal(5, 2)
  whtRateCompany    Decimal  @default(10) @db.Decimal(5, 2)
  whtRateIndividual Decimal  @default(5) @db.Decimal(5, 2)
  driveConnected    Boolean  @default(false)
  driveRefreshToken String?
  gmailRefreshToken String?
  gmailEmail        String?
  driveSyncSchedule String   @default("MANUAL")
  driveEnabled      Boolean  @default(true)
  gmailEnabled      Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model Company {
  id        String   @id
  name      String
  slug      String?  @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           Account[]
  journalEntries     JournalEntry[]
  customers          Customer[]
  vendors            Vendor[]
  items              Item[]
  salesInvoices      SalesInvoice[]
  purchaseBills      PurchaseBill[]
  bankTransactions   BankTransaction[]
  employees          Employee[]
  payrollRuns        PayrollRun[]
  fixedAssets        FixedAsset[]
  expenses           Expense[]
  expenseCategories  ExpenseCategory[]
  budgets            Budget[]
  businessProfile    BusinessProfile?
  members            Member[]
  invitations        Invitation[]
  documents          Document[]
  auditLogs          AuditLog[]
  equityTransactions EquityTransaction[]
  loans              Loan[]
  projects           Project[]
}

// ---------------------------------------------------------------------------
// Better Auth (Google OAuth only — no password hashes)
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    AuthAccount[]
  members     Member[]
  invitations Invitation[]
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// OAuth provider accounts (named AuthAccount to avoid the ledger Account).
model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime @default(now())

  organization Company @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  inviterId      String

  organization Company @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User    @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model Document {
  id            String   @id @default(cuid())
  companyId     String   @default("default")
  filename      String
  originalName  String
  mimeType      String
  filePath      String
  uploadedAt    DateTime @default(now())
  status        String   @default("PENDING")
  source        String   @default("OCR")
  extractedData Json?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String   @default("default")
  userId     String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([action])
  @@index([entityType])
}

model EquityTransaction {
  id          String   @id @default(cuid())
  companyId   String   @default("default")
  type        String
  amount      Decimal  @db.Decimal(18, 2)
  date        DateTime
  description String
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([type])
}

model Loan {
  id              String   @id @default(cuid())
  companyId       String   @default("default")
  lenderName      String
  principalAmount Decimal  @db.Decimal(18, 2)
  interestRate    Decimal  @db.Decimal(5, 2)
  startDate       DateTime
  termMonths      Int
  balance         Decimal  @db.Decimal(18, 2)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  repayments LoanRepayment[]

  @@index([companyId])
  @@index([status])
}

model LoanRepayment {
  id            String   @id @default(cuid())
  loanId        String
  date          DateTime
  principalPaid Decimal  @db.Decimal(18, 2)
  interestPaid  Decimal  @db.Decimal(18, 2)
  totalPaid     Decimal  @db.Decimal(18, 2)
  createdAt     DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
}

model Project {
  id        String    @id @default(cuid())
  companyId String    @default("default")
  name      String
  clientId  String?
  budget    Decimal   @default(0) @db.Decimal(18, 2)
  startDate DateTime
  endDate   DateTime?
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client       Customer?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  transactions ProjectTransaction[]

  @@index([companyId])
  @@index([clientId])
  @@index([status])
}

model ProjectTransaction {
  id          String   @id @default(cuid())
  projectId   String
  date        DateTime
  description String
  amount      Decimal  @db.Decimal(18, 2)
  type        String
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
}
