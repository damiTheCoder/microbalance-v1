    "better-auth": "^1.7.25",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.8",
    "googleapis": "^190.0.0",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.7",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
