{
  "name": "@microbalance/dsh-tool-microbalance-tools",
  "version": "0.1.0",
  "description": "DeepSeek Harness tools for the MicroBalance double-entry accounting engine",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "smoke": "tsx scripts/smoke.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-util-values": "^0.2.2-rc.2"
  }
}
